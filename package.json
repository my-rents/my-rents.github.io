{
  "name": "my-rents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "sync:play-pricing": "node ./scripts/sync-play-pricing.mjs",
    "test:unit": "vitest",
    "test:ci": "vitest run",
    "build-only": "vite build",
    "type-check": "run-p type-check:site type-check:portal",
    "type-check:site": "vue-tsc --build",
    "type-check:portal": "tsc -p portal/tsconfig.app.json",
    "lint": "run-s lint:eslint lint:portal lint:oxlint",
    "lint:fix": "run-s lint:eslint:fix lint:portal:fix lint:oxlint:fix",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix --cache",
    "lint:portal": "eslint -c portal/eslint.config.js portal/src --cache",
    "lint:portal:fix": "eslint -c portal/eslint.config.js portal/src --fix --cache",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@lineiconshq/free-icons": "^1.0.4",
    "file-saver": "^2.0.5",
    "firebase": "^12.11.0",
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3",
    "yet-another-react-lightbox": "^3.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-vue": "~10.8.0",
    "globals": "^17.4.0",
    "google-auth-library": "^10.6.2",
    "jiti": "^2.6.1",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "prettier": "3.8.1",
    "sass": "^1.98.0",
    "sass-embedded": "^1.93.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
